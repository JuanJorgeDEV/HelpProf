# Copiar para backend/.env — NÃO commitar segredos

ENVIRONMENT=development

SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# HS256 (legado): usar SUPABASE_JWT_SECRET. RS*/ES* (atual): validação via JWKS — precisa de SUPABASE_URL.
SUPABASE_JWT_SECRET=

GEMINI_API_KEY=

ADMIN_EMAILS=

EMBED_WEBHOOK_SECRET=

LUME_SIMILARITY_FLOOR=0.28
LUME_LEXICAL_FALLBACK_LIMIT=8

# CSV — inclua Live Server e localhost da API
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
